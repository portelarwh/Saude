{
  "expo": {
    "name": "Meu Equilíbrio",
    "slug": "meu-equilibrio",
    "scheme": "meuequilibrio",
    "version": "1.0.2",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "br.app.meuequilibrio"
    },
    "android": {
      "package": "br.app.meuequilibrio",
      "adaptiveIcon": {
        "backgroundColor": "#10281E",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "CAMERA",
        "POST_NOTIFICATIONS"
      ],
      "blockedPermissions": [
        "RECORD_AUDIO"
      ],
      "predictiveBackGestureEnabled": false,
      "versionCode": 10002
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "name": "Meu Equilíbrio",
      "shortName": "Equilíbrio",
      "lang": "pt-BR",
      "themeColor": "#1C5E3F",
      "backgroundColor": "#10281E",
      "description": "Diário alimentar, água, metas, composição corporal e relatórios."
    },
    "plugins": [
      "expo-router",
      "expo-sharing",
      [
        "expo-camera",
        {
          "cameraPermission": "O Meu Equilíbrio usa a câmera para ler códigos de barras e fotografar rótulos e exames.",
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": true
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Permite escolher fotos de rótulos, exames e planos alimentares.",
          "cameraPermission": "O Meu Equilíbrio usa a câmera para fotografar rótulos e exames."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#1C5E3F"
        }
      ]
    ]
  }
}
