# Copie para .env e preencha para usar o modo nuvem (Supabase).
# Sem estas variáveis o app funciona no "modo local" (dados apenas no aparelho, sem IA).
EXPO_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=sua-chave-anon-publica

# Segredos das Edge Functions NÃO vão aqui. Configure com:
#   supabase secrets set ANTHROPIC_API_KEY=... USDA_API_KEY=... AI_MODEL=claude-opus-5-5
